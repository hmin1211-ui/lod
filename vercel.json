{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"No install required\"",
  "buildCommand": "node tools/build-static.mjs",
  "outputDirectory": "vercel-static",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/calculator",
      "destination": "/calculator/index.html"
    },
    {
      "source": "/calculator/(.*)",
      "destination": "/calculator/$1"
    }
  ]
}
